alias b='cd -'
alias bat='batcat'
alias c='clear'
alias cat='batcat -pp'
alias cm='chezmoi'
alias d='docker'
alias fd='fdfind'
alias k='kubectl'
alias kk='k9s'
alias l='nvim'
alias lg='lazygit'
alias lc='lazydocker'
alias ls='eza --icons -1'
alias ll='eza -hal --header --icons'
alias la='eza --icons -TL2'
alias q='exit'
alias t='tldr'
alias up='sudo apt update && sudo apt upgrade -y && mise self-update -y && mise up'
alias zj='zellij -l devops options --session-name $(basename $PWD)'
alias zja='zellij -l devops options --session-name $(basename $PWD) --attach-to-session true'
