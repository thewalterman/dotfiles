alias b='cd -'
alias bat='batcat'
alias c='clear'
alias cat='batcat -pp'
alias cm='chezmoi'
alias d='docker'
alias fd='fdfind'
alias k='kubectl'
alias kk='k9s'
alias lg='lazygit'
alias lc='lazydocker'
alias es='eza --icons -1'
alias ea='eza --icons -TL2'
alias ee='eza -hal --header --icons'
alias l='nvim'
alias q='exit'
alias t='tldr'
alias up='sudo apt update && sudo apt upgrade -y && mise self-update -y && mise up'
